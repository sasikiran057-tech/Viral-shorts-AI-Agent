{
  "name": "viral-shorts-backend",
  "version": "1.0.0",
  "description": "Backend API for Viral Shorts AI Agent",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "dev": "nodemon --exec node src/server.js",
    "start": "node src/server.js",
    "build": "echo 'No build step needed for Node.js'",
    "workers:dev": "nodemon --exec node src/workers/index.js",
    "workers:start": "node src/workers/index.js",
    "db:setup": "node scripts/setupDatabase.js",
    "db:migrate": "node scripts/runMigrations.js",
    "db:seed": "node scripts/seedDatabase.js",
    "db:reset": "npm run db:setup && npm run db:seed",
    "test": "NODE_ENV=test node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:watch": "NODE_ENV=test node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:e2e": "NODE_ENV=test node --experimental-vm-modules node_modules/jest/bin/jest.js e2e --runInBand",
    "lint": "eslint src --ext .js",
    "lint:fix": "eslint src --ext .js --fix",
    "format": "prettier --write src",
    "format:check": "prettier --check src"
  },
  "dependencies": {
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.0",
    "dotenv": "^16.3.1",
    "jsonwebtoken": "^9.1.2",
    "bcryptjs": "^2.4.3",
    "pg": "^8.11.3",
    "mongoose": "^8.0.0",
    "redis": "^4.6.12",
    "bull": "^4.11.5",
    "axios": "^1.6.2",
    "openai": "^4.24.0",
    "node-fetch": "^3.3.2",
    "fluent-ffmpeg": "^2.1.2",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "joi": "^17.11.0",
    "lodash": "^4.17.21",
    "moment": "^2.29.4",
    "multer": "^1.4.5-lts.1",
    "sharp": "^0.33.0",
    "stripe": "^14.10.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "eslint": "^8.54.0",
    "prettier": "^3.1.0",
    "jest": "^29.7.0",
    "supertest": "^6.3.3"
  }
}
