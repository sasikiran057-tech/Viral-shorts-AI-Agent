PORT=3000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/viral_shorts_db

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-32-character-secret-key-here-change-in-production
JWT_EXPIRE=7d

# Frontend
FRONTEND_URL=http://localhost:5173

# Logging
LOG_LEVEL=debug

# OpenAI
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_MAX_TOKENS=2000
OPENAI_TEMPERATURE=0.7

# YouTube
YOUTUBE_CLIENT_ID=your-client-id
YOUTUBE_CLIENT_SECRET=your-client-secret
YOUTUBE_API_KEY=your-api-key
YOUTUBE_REDIRECT_URL=http://localhost:3000/auth/youtube/callback

# Instagram
INSTAGRAM_APP_ID=your-app-id
INSTAGRAM_APP_SECRET=your-app-secret
INSTAGRAM_API_VERSION=v18.0
INSTAGRAM_REDIRECT_URL=http://localhost:3000/auth/instagram/callback

# Facebook
FACEBOOK_APP_ID=your-app-id
FACEBOOK_APP_SECRET=your-app-secret
FACEBOOK_API_VERSION=v18.0
FACEBOOK_REDIRECT_URL=http://localhost:3000/auth/facebook/callback

# ElevenLabs
ELEVEN_LABS_API_KEY=your-api-key
ELEVEN_LABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVEN_LABS_MODEL_ID=eleven_monolingual_v1

# FFmpeg
FFMPEG_PATH=/usr/local/bin/ffmpeg
FFPROBE_PATH=/usr/local/bin/ffprobe

# Video Settings
VIDEO_RESOLUTION=1080x1920
VIDEO_BITRATE=5000k
VIDEO_FRAMERATE=30

# Storage
STORAGE_TYPE=local
STORAGE_PATH=./uploads
