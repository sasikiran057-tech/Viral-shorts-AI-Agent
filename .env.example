# ============================================
# VIRAL SHORTS AI AGENT - ENVIRONMENT CONFIG
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ============================================
# SERVER CONFIGURATION
# ============================================
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3000
API_BASE_URL=/api/v1

# ============================================
# DATABASE
# ============================================
# PostgreSQL (recommended for production)
DATABASE_TYPE=postgresql
DATABASE_URL=postgresql://user:password@localhost:5432/viral_shorts_db
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=viral_user
DATABASE_PASSWORD=change_me_in_production
DATABASE_NAME=viral_shorts_db

# OR MongoDB (alternative)
# DATABASE_TYPE=mongodb
# MONGODB_URI=mongodb://localhost:27017/viral_shorts_db

# ============================================
# REDIS (Job Queue & Caching)
# ============================================
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# ============================================
# AUTHENTICATION & SECURITY
# ============================================
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-long-change-this
JWT_EXPIRY=7d
JWT_REFRESH_EXPIRY=30d
BCRYPT_ROUNDS=10
CORS_ORIGIN=http://localhost:5173
RATI_LIMIT_WINDOW=15m
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# OPENAI API (Script & Content Generation)
# ============================================
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_ORG_ID=
OPENAI_MAX_TOKENS=2000
OPENAI_TEMPERATURE=0.7

# ============================================
# YOUTUBE DATA API
# ============================================
YOUTUBE_CLIENT_ID=your-client-id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your-client-secret
YOUTUBE_REDIRECT_URL=http://localhost:3000/api/v1/auth/youtube/callback
YOUTUBE_API_KEY=your-youtube-api-key

# ============================================
# INSTAGRAM / META GRAPH API
# ============================================
INSTAGRAM_APP_ID=your-app-id
INSTAGRAM_APP_SECRET=your-app-secret
INSTAGRAM_REDIRECT_URL=http://localhost:3000/api/v1/auth/instagram/callback
INSTAGRAM_API_VERSION=v18.0

# ============================================
# FACEBOOK GRAPH API
# ============================================
FACEBOOK_APP_ID=your-app-id
FACEBOOK_APP_SECRET=your-app-secret
FACEBOOK_REDIRECT_URL=http://localhost:3000/api/v1/auth/facebook/callback
FACEBOOK_API_VERSION=v18.0

# ============================================
# ELEVENLABS (Voice-over Generation)
# ============================================
ELEVEN_LABS_API_KEY=your-api-key
ELEVEN_LABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVEN_LABS_MODEL_ID=eleven_monolingual_v1

# ============================================
# TREND DISCOVERY APIS
# ============================================
# Optional: Use public data or configure paid APIs
TREND_API_ENABLED=true
TREND_API_TYPE=youtube  # youtube, trending, google_trends
TRENDING_API_KEY=
GOOGLE_TRENDS_REGION=US

# ============================================
# FILE STORAGE
# ============================================
UPLOAD_DIR=./uploads
VIDEO_OUTPUT_DIR=./videos
MAX_FILE_SIZE=500m
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,mp4,mov,webm

# ============================================
# FFmpeg CONFIGURATION
# ============================================
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
VIDEO_BITRATE=5000k
VIDEO_RESOLUTION=1080x1920
AUDIO_BITRATE=128k
FRAME_RATE=30

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=debug
LOG_DIR=./logs
LOG_FILE=app.log
LOG_MAX_SIZE=10m
LOG_MAX_FILES=7

# ============================================
# FEATURE FLAGS
# ============================================
FEATURE_VIDEO_GENERATION=true
FEATURE_VOICE_OVER=true
FEATURE_PUBLISHING=true
FEATURE_ANALYTICS=true
FEATURE_TREND_DISCOVERY=true

# ============================================
# JOB QUEUE CONFIGURATION
# ============================================
JOB_QUEUE_TYPE=redis  # redis, bull, resque
JOB_QUEUE_CONCURRENCY=2
JOB_QUEUE_ATTEMPTS=3
JOB_QUEUE_BACKOFF=exponential

# ============================================
# SECURITY & AUDIT
# ============================================
AUDIT_LOG_ENABLED=true
ENCRYPTION_KEY=your-32-char-encryption-key-min-length
ENCRYPT_SENSITIVE_FIELDS=true

# ============================================
# STRIPE (Optional Payment Processing)
# ============================================
STRIPE_ENABLED=false
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ============================================
# SENTRY (Error Tracking - Optional)
# ============================================
SENTRY_ENABLED=false
SENTRY_DSN=

# ============================================
# SMTP (Email Configuration)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@viralshorts.com
